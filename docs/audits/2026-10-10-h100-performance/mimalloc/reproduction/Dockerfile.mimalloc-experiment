ARG BASE_IMAGE
FROM ubuntu:22.04 AS mimalloc-builder
COPY deploy/docker/mimalloc/build.sh deploy/docker/mimalloc/verify.c /build/
RUN sh /build/build.sh

FROM ${BASE_IMAGE}
COPY --from=mimalloc-builder /opt/mimalloc/ /opt/mimalloc/
COPY deploy/scripts/with_mimalloc.sh /usr/local/bin/aquillm-allocator
RUN chmod 755 /usr/local/bin/aquillm-allocator
ENV AQUILLM_ALLOCATOR=system
ENTRYPOINT ["/usr/local/bin/aquillm-allocator", "/genesis_entrypoint.sh"]
