# Build against the captured Genesis service image ID; no dependency upgrades.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER root
COPY deploy/vllm_plugins/h100_kernels /opt/aquillm-h100
RUN python3 -m pip install --no-deps --no-build-isolation /opt/aquillm-h100 \
    && python3 -m aquillm_vllm_h100.build_hook /opt/genesis/sndr/plugin.py
